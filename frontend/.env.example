# Chỉ dùng lúc chạy `npm run dev` / `npm run preview` (không nhúng vào bundle). Chép thành .env để sửa.

# Nơi proxy /api:
#   mock    — mọi màn chạy trên mock API (mặc định, không cần DB)
#   hybrid  — endpoint BE .NET đã làm (danh sách BACKEND_ROUTES trong vite.config.ts) → BE thật, còn lại → mock
#   backend — mọi /api → BE thật (endpoint chưa làm trả 404)
# Không đặt biến này thì `npm run dev` = mock, `npm run dev:hybrid` = hybrid, `npm run dev:backend` = backend.
# DX_API_MODE=mock
DX_MOCK_API_TARGET=http://127.0.0.1:5080
DX_BACKEND_TARGET=http://127.0.0.1:5090

# npm run dev / dev:hybrid tự bật mock API nếu cổng mock còn trống; 0 = không tự bật
# DX_MOCK_AUTOSTART=1

# Nhãn môi trường hiển thị trên giao diện: development | test | production
# "test" hiện dải "Môi trường kiểm thử" trên đầu trang.
VITE_APP_ENV=development
