{
  "name": "dx-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:hybrid": "vite --mode hybrid",
    "dev:backend": "vite --mode backend",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "i18n:check": "node ../tools/i18n-check/i18n-check.mjs",
    "mock-api": "node ../tools/mock-api/server.mjs",
    "mock-data": "node ../tools/mock-data-gen/generate.mjs",
    "verify": "npm run i18n:check && npm run lint && npm run build"
  },
  "dependencies": {
    "@lucide/vue": "^1.16.0",
    "@tanstack/vue-query": "^5.90.0",
    "@vueuse/core": "^13.9.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "pinia": "^3.0.3",
    "reka-ui": "^2.5.0",
    "tailwind-merge": "^3.3.1",
    "vue": "^3.5.22",
    "vue-i18n": "^11.1.12",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@intlify/eslint-plugin-vue-i18n": "^4.1.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^22.18.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.5.0",
    "jsonc-eslint-parser": "^2.4.0",
    "tailwindcss": "^4.1.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vue-tsc": "^3.1.0"
  }
}
