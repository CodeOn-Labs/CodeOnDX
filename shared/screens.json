{
  "$comment": "Danh mục màn hình — nguồn duy nhất cho: cấp 1 của key i18n FE, đường dẫn + quyền của route FE (router.ts dựng route từ đây; extra_routes = đường dẫn phụ cùng màn, permission riêng nếu khác; guest_only = đã đăng nhập thì không vào), Màn hình áp dụng của AI Insight (parent = kế thừa theo ADR-0001), tên file mock-data/ai/insights/<screen_key>.json. Thêm màn mới: thêm dòng ở đây trước.",
  "auth_login": { "route": "/auth/login", "public": true, "guest_only": true },
  "auth_forgot_password": { "route": "/auth/forgot-password", "public": true, "guest_only": true },
  "auth_reset_password": { "route": "/auth/reset-password/:token", "public": true },
  "css_survey_public": { "route": "/khao-sat-css/:token", "public": true },
  "profile": { "route": "/profile" },
  "timesheet": { "route": "/timesheets", "permission": ["timesheet.edit", "timesheet.team"] },
  "timesheet_day": { "parent": "timesheet" },
  "timesheet_week": { "parent": "timesheet" },
  "timesheet_approval": { "parent": "timesheet", "permission": ["timesheet.approve"] },
  "leave_request": { "route": "/leave", "permission": ["timesheet.edit", "timesheet.approve"] },
  "leave_approval": { "parent": "leave_request", "permission": ["timesheet.approve"] },
  "attendance": { "route": "/attendance", "permission": ["timesheet.edit", "timesheet.all_view", "timesheet.all_edit"] },
  "effort": { "route": "/effort", "permission": ["effort.view"] },
  "project_list": { "route": "/projects", "permission": ["project.view"] },
  "project_form": { "route": "/projects/new", "permission": ["project.create"], "extra_routes": [{ "route": "/projects/:id/edit", "permission": ["project.manage"] }] },
  "project_detail": { "route": "/projects/:id", "permission": ["project.view"] },
  "project_detail_overview": { "parent": "project_detail" },
  "project_detail_monthly_report": { "parent": "project_detail" },
  "project_detail_metrics": { "parent": "project_detail" },
  "project_detail_metrics_timeline": { "parent": "project_detail_metrics" },
  "project_detail_metrics_ee": { "parent": "project_detail_metrics" },
  "project_detail_metrics_pcv": { "parent": "project_detail_metrics" },
  "project_detail_metrics_css": { "parent": "project_detail_metrics" },
  "project_detail_metrics_defect": { "parent": "project_detail_metrics" },
  "project_detail_metrics_leakage": { "parent": "project_detail_metrics" },
  "project_detail_management": { "parent": "project_detail" },
  "project_detail_management_documents": { "parent": "project_detail_management", "inherit_insights": false },
  "project_detail_management_risk": { "parent": "project_detail_management", "inherit_insights": false },
  "project_detail_management_change": { "parent": "project_detail_management", "inherit_insights": false },
  "project_detail_management_issue": { "parent": "project_detail_management", "inherit_insights": false },
  "employee_list": { "route": "/admin/employees", "permission": ["employee.view"] },
  "employee_detail": { "route": "/admin/employees/:id", "permission": ["employee.view"] },
  "admin_department_list": { "route": "/admin/departments", "permission": ["employee.view"] },
  "admin_role_list": { "route": "/admin/roles", "permission": ["admin.roles"] },
  "admin_role_form": { "route": "/admin/roles/:id", "permission": ["admin.roles"], "extra_routes": [{ "route": "/admin/roles/new" }] },
  "admin_rule_list": { "route": "/admin/rules", "permission": ["admin.settings"] },
  "admin_insight_list": { "route": "/admin/insights", "permission": ["admin.insights"] },
  "admin_insight_form": { "route": "/admin/insights/:id", "permission": ["admin.insights"], "extra_routes": [{ "route": "/admin/insights/new" }] },
  "admin_prompt_template_list": { "route": "/admin/prompt-templates", "permission": ["admin.insights"] },
  "admin_prompt_template_form": { "route": "/admin/prompt-templates/:id", "permission": ["admin.insights"], "extra_routes": [{ "route": "/admin/prompt-templates/new" }] },
  "admin_integration_list": { "route": "/admin/integrations", "permission": ["admin.integrations"] },
  "admin_category_list": { "route": "/admin/categories", "permission": ["admin.settings"] },
  "admin_client_list": { "route": "/admin/clients", "permission": ["admin.settings"] },
  "admin_setting": { "route": "/admin/settings", "permission": ["admin.settings"] },
  "admin_pcv_criteria": { "route": "/admin/pcv-criteria", "permission": ["admin.settings"] },
  "admin_css_template": { "route": "/admin/css-template", "permission": ["admin.settings"] }
}
