{
  "ConnectionStrings": {
    "Dx": "Host=localhost;Port=5432;Database=dx;Username=dx_app",
    "DxOwner": "Host=localhost;Port=5432;Database=dx;Username=dx_owner"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://127.0.0.1:8082" }
    }
  },
  "Jwt": {
    "Issuer": "dx.codeonlabs.vn",
    "Audience": "dx-spa",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "Auth": {
    "RefreshTokenDays": 7,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "IpMaxFailures": 5,
    "IpWindowMinutes": 5
  },
  "Database": {
    "AppRole": "dx_app",
    "DemoSeedPath": "seed/demo_tenant.sql"
  },
  "OpenApi": {
    "Expose": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/dx-api-.log", "rollingInterval": "Day", "retainedFileCountLimit": 30 } }
    ]
  },
  "AllowedHosts": "*"
}
