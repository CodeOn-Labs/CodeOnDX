<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>codeon-dx-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dx.Infrastructure\Dx.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.13" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.18.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Messages of the API (Q1), also read by tools/mock-api -->
    <Content Update="Locales\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Demo tenant script generated by tools/db-seed/generate.mjs (used by the seed-demo command) -->
    <None Include="..\..\..\database\seed\demo_tenant.sql" Link="seed\demo_tenant.sql" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\..\database\seed\demo_tenant.sql')" />
    <Content Update="appsettings.Secrets*.json" CopyToPublishDirectory="Never" />
    <!-- Screen catalog shared with the FE (AI insight chain, prompt screens) -->
    <None Include="..\..\..\shared\screens.json" Link="shared\screens.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Fictitious data the connectors answer with in mock mode (Q3, JsonMockDataStore) -->
    <None Include="..\..\..\mock-data\ai\**\*.json" LinkBase="mock-data\ai" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\mock-data\github\**\*.json" LinkBase="mock-data\github" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\mock-data\gitlab\**\*.json" LinkBase="mock-data\gitlab" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\..\mock-data\google-drive\**\*.json" LinkBase="mock-data\google-drive" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
